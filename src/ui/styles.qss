/* Premium light theme for Smart Computer Health Monitor */

QWidget {
    background-color: #F5F7FB;
    color: #172033;
    font-family: "Segoe UI", "Inter", -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    font-size: 14px;
    selection-background-color: #DCE8FF;
    selection-color: #172033;
}

QMainWindow {
    background-color: #F5F7FB;
}

QScrollArea,
QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

/* Sidebar */

#sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E5EAF1;
    min-width: 248px;
    max-width: 248px;
}

#sidebarHeader {
    padding: 22px 18px 19px 18px;
    border-bottom: 1px solid #E5EAF1;
}

#appTitle {
    font-size: 18px;
    font-weight: 700;
    color: #172033;
    letter-spacing: 0.3px;
}

#appSubtitle {
    font-size: 12px;
    font-weight: 600;
    color: #2563EB;
    margin-top: 4px;
}

QPushButton.nav-btn {
    background-color: transparent;
    color: #667085;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 11px 15px;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
    margin: 3px 12px;
}

QPushButton.nav-btn:hover {
    background-color: #F2F6FC;
    color: #172033;
    border-color: #E5EAF1;
}

QPushButton.nav-btn:focus {
    border: 1px solid #93B4F8;
}

QPushButton.nav-btn:checked,
QPushButton.nav-btn.active {
    background-color: #EEF4FF;
    color: #2563EB;
    font-weight: 650;
    border: 1px solid #D7E4FF;
    border-left: 3px solid #2563EB;
    padding-left: 13px;
}

/* Main surfaces */

QFrame.card-panel {
    background-color: #FFFFFF;
    border: 1px solid #E5EAF1;
    border-radius: 12px;
    padding: 17px;
}

QFrame.card-panel:hover {
    border-color: #C9D8F5;
}

QStatusBar {
    background-color: #FFFFFF;
    color: #667085;
    border-top: 1px solid #E5EAF1;
    font-size: 12px;
    padding: 3px 10px;
}

/* Buttons */

QPushButton.btn-primary {
    background-color: #2563EB;
    color: #FFFFFF;
    border: 1px solid #2563EB;
    border-radius: 8px;
    padding: 9px 17px;
    font-weight: 700;
}

QPushButton.btn-primary:hover {
    background-color: #1D4ED8;
    border-color: #1D4ED8;
}

QPushButton.btn-primary:pressed {
    background-color: #1E40AF;
}

QPushButton.btn-secondary {
    background-color: #FFFFFF;
    color: #344054;
    border: 1px solid #D0D5DD;
    border-radius: 8px;
    padding: 9px 17px;
    font-weight: 600;
}

QPushButton.btn-secondary:hover {
    background-color: #F8FAFC;
    color: #172033;
    border-color: #98A2B3;
}

QPushButton.btn-secondary:pressed {
    background-color: #F2F4F7;
}

QPushButton.btn-danger {
    background-color: #FFF1F2;
    color: #B42318;
    border: 1px solid #FDA4AF;
    border-radius: 8px;
    padding: 7px 13px;
    font-weight: 700;
}

QPushButton.btn-danger:hover {
    background-color: #FFE4E6;
    border-color: #DC2626;
}

QPushButton:disabled {
    background-color: #F2F4F7;
    color: #98A2B3;
    border-color: #E5E7EB;
}

/* Status badges */

QLabel.badge-excellent,
QLabel.badge-healthy {
    background-color: #ECFDF3;
    color: #15803D;
    border: 1px solid #ABEFC6;
    border-radius: 11px;
    padding: 4px 11px;
    font-weight: 700;
    font-size: 12px;
}

QLabel.badge-good {
    background-color: #ECFEFF;
    color: #0E7490;
    border: 1px solid #A5F3FC;
    border-radius: 11px;
    padding: 4px 11px;
    font-weight: 700;
    font-size: 12px;
}

QLabel.badge-warning {
    background-color: #FFFAEB;
    color: #B54708;
    border: 1px solid #FEDF89;
    border-radius: 11px;
    padding: 4px 11px;
    font-weight: 700;
    font-size: 12px;
}

QLabel.badge-critical {
    background-color: #FEF3F2;
    color: #B42318;
    border: 1px solid #FDA29B;
    border-radius: 11px;
    padding: 4px 11px;
    font-weight: 700;
    font-size: 12px;
}

/* Tables */

QTableWidget,
QTableView {
    background-color: #FFFFFF;
    border: 1px solid #E5EAF1;
    border-radius: 10px;
    gridline-color: #F0F2F5;
    color: #172033;
    selection-background-color: #EEF4FF;
    selection-color: #172033;
    outline: none;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #667085;
    font-weight: 700;
    padding: 10px 11px;
    border: none;
    border-bottom: 1px solid #E5EAF1;
}

QTableWidget::item {
    padding: 8px 10px;
    border-bottom: 1px solid #F0F2F5;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background-color: #EEF4FF;
}

/* Form controls */

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #FFFFFF;
    color: #172033;
    border: 1px solid #D0D5DD;
    border-radius: 8px;
    padding: 8px 11px;
    font-size: 14px;
}

QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #98A2B3;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #2563EB;
    background-color: #FFFFFF;
}

QComboBox::drop-down {
    border: none;
    width: 25px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #172033;
    border: 1px solid #D0D5DD;
    selection-background-color: #EEF4FF;
    selection-color: #172033;
}

/* Progress bars */

QProgressBar {
    background-color: #F2F4F7;
    border: 1px solid #E5EAF1;
    border-radius: 6px;
    text-align: center;
    color: #344054;
    font-size: 12px;
    font-weight: 700;
    height: 13px;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 5px;
}

/* Scrollbars */

QScrollBar:vertical {
    border: none;
    background: #F5F7FB;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 28px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #98A2B3;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    border: none;
    background: #F5F7FB;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    min-width: 28px;
    border-radius: 5px;
}

/* Tabs, dialogs, menus, and tooltips */

QTabWidget::pane {
    border: 1px solid #E5EAF1;
    background-color: #FFFFFF;
    border-radius: 10px;
}

QTabBar::tab {
    background-color: #F8FAFC;
    color: #667085;
    padding: 9px 19px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 5px;
    font-weight: 600;
}

QTabBar::tab:hover {
    color: #172033;
    background-color: #F2F6FC;
}

QTabBar::tab:selected {
    background-color: #EEF4FF;
    color: #2563EB;
    font-weight: 700;
    border-bottom: 2px solid #2563EB;
}

QDialog,
QMessageBox {
    background-color: #FFFFFF;
}

QToolTip {
    background-color: #172033;
    color: #FFFFFF;
    border: 1px solid #344054;
    padding: 7px 10px;
    border-radius: 6px;
    font-size: 13px;
}

QMenu {
    background-color: #FFFFFF;
    color: #172033;
    border: 1px solid #D0D5DD;
    padding: 5px;
}

QMenu::item {
    padding: 7px 24px 7px 12px;
    border-radius: 5px;
}

QMenu::item:selected {
    background-color: #EEF4FF;
    color: #2563EB;
}
